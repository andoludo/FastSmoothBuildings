within FastSmoothBuildings.Utilities;
package Validation "Validation models of the package"
  extends FastSmoothBuildings.Icons.ExamplesPackage;
  annotation (Documentation(info="<html>
<p>
Models that exercise the classes of the package over a range of their inputs; the tests of the repository compare
their results in OpenModelica with reference results, and with closed forms where there is one.
</p>
</html>"));
end Validation;
