within FastSmoothBuildings.UsersGuide;
class License "License"
  extends FastSmoothBuildings.Icons.Information;
  annotation (preferredView="info", Documentation(info="<html>
<p>
FastSmoothBuildings is released under the BSD 3-Clause License. Copyright (c) 2026, Ando Andriamamonjy and the
contributors of FastSmoothBuildings.
</p>
<p>
Portions of the library follow the models and functions of the
<a href=\"https://github.com/lbl-srg/modelica-buildings\">Modelica Buildings Library</a>: the smooth functions, the
solar position and the Perez sky model, the heat transfer of walls, windows and rooms, the correlations of the gas
gaps, the overhangs and side fins, the EN 442 radiator, the boiler, the heat pump data and the photovoltaic model.
For those portions, the license of the Modelica Buildings Library applies too. Both licenses are in the file
<code>LICENSE</code> at the root of the repository.
</p>
</html>"));
end License;
