within FastSmoothBuildings.UsersGuide;
class ReleaseNotes "Release notes"
  extends FastSmoothBuildings.Icons.Information;
  annotation (preferredView="info", Documentation(info="<html>
<h4>Version 0.1.0</h4>
<p>
First release as FastSmoothBuildings: the package <code>FastModel</code> of
<a href=\"https://github.com/andoludo/trano\">trano</a> (trano commit c70f8d2), renamed and stored in the directory
layout of the Modelica specification, with this User's Guide, examples and validation models.
</p>
</html>"));
end ReleaseNotes;
