within FastSmoothBuildings;
package Zones "Thermal zones"
  annotation (Documentation(info="<html>
<p>
Thermal zones after Buildings.ThermalZones.Detailed.MixedAir: the room air, the long-wave exchange between its surfaces through a radiant star, the distribution of the transmitted sun, infiltration and scheduled outdoor air, internal gains.
</p>
</html>"));
end Zones;
