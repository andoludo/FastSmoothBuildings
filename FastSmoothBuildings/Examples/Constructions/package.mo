within FastSmoothBuildings.Examples;
package Constructions "Constructions and glazings of the examples"
  extends FastSmoothBuildings.Icons.Package;
  annotation (Documentation(info="<html>
<p>
The constructions of BESTEST case 600 (ASHRAE Standard 140) and of trano's single-zone hydronic test, written as
trano writes them: the counts of sublayers and the indices of the nodes are literal (see
<a href=\"modelica://FastSmoothBuildings.UsersGuide.Translation\">Translation into CasADi</a>).
</p>
</html>"));
end Constructions;
