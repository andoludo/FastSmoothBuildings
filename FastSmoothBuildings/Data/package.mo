within FastSmoothBuildings;
package Data "Records of constructions and glazings, written by trano from the YAML file"
  annotation (Documentation(info="<html>
<p>
Records of the constructions and glazings. The counts of layers, sublayers and panes and the indices of the nodes are written out in each record (see <a href=\"modelica://FastSmoothBuildings.UsersGuide.Translation\">Translation into CasADi</a>).
</p>
</html>"));
end Data;
