within FastSmoothBuildings;
package Envelope "Walls, floors, roofs and windows (after Buildings.ThermalZones.Detailed and Buildings.HeatTransfer)"
  annotation (Documentation(info="<html>
<p>
Walls, floors, roofs and windows after Buildings.ThermalZones.Detailed and Buildings.HeatTransfer: conduction through layers split into sublayers, exterior and interior convection, long-wave exchange with sky and ground, absorbed and transmitted sun, gas gaps of the glazing at the temperatures of their panes, frames, overhangs and side fins.
</p>
</html>"));
end Envelope;
