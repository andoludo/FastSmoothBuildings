within FastSmoothBuildings;
package BoundaryConditions "Weather and solar irradiance (after Buildings.BoundaryConditions)"
  annotation (Documentation(info="<html>
<p>
Weather data and solar irradiance after Buildings.BoundaryConditions: the weather inputs of a model, the solar position, the Perez sky model and the irradiance on tilted surfaces, without the events of a weather file reader.
</p>
</html>"));
end BoundaryConditions;
